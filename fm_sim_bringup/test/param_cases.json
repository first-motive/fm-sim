{
  "_comment": "Tunable declarations, values, and whether they are accepted. test_params.py checks fm_sim_bringup.params.check_value against this table; agent/tests/test_params.py checks the sim agent's mirror against it, so the agent refuses exactly what the launch refuses. An accepted case gives the normalised value; a refused one a phrase both messages carry. NaN and Infinity are the JSON extension Python reads and writes: a caller's body can carry them.",
  "cases": [
    {
      "name": "a float in bounds",
      "param": {
        "type": "float",
        "min": 0.1,
        "max": 2.0
      },
      "value": 1.5,
      "accepted": true,
      "normalised": 1.5
    },
    {
      "name": "an int for a float renders as a float",
      "param": {
        "type": "float",
        "min": 0.1,
        "max": 2.0
      },
      "value": 1,
      "accepted": true,
      "normalised": 1.0
    },
    {
      "name": "a float at its bound",
      "param": {
        "type": "float",
        "min": 0.1,
        "max": 2.0
      },
      "value": 2.0,
      "accepted": true,
      "normalised": 2.0
    },
    {
      "name": "a float above its max",
      "param": {
        "type": "float",
        "min": 0.1,
        "max": 2.0
      },
      "value": 2.5,
      "accepted": false,
      "reason": "between"
    },
    {
      "name": "true is not a float",
      "param": {
        "type": "float",
        "min": 0.1,
        "max": 2.0
      },
      "value": true,
      "accepted": false,
      "reason": "number"
    },
    {
      "name": "a string is not a float",
      "param": {
        "type": "float",
        "min": 0.1,
        "max": 2.0
