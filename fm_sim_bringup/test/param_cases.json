      "value": "1.5",
      "accepted": false,
      "reason": "number"
    },
    {
      "name": "an int in bounds",
      "param": {
        "type": "int",
        "min": 1,
        "max": 100
      },
      "value": 7,
      "accepted": true,
      "normalised": 7
    },
    {
      "name": "a float is not an int",
      "param": {
        "type": "int",
        "min": 1,
        "max": 100
