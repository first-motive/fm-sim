# fm_sim_bringup run contract. run.launch.py takes four names, resolves each from
# the ament index (fm_sim.* resource types), expands the robot's fm-robot xacro
# with the backend's args, builds a world from the scenario and seed (on MuJoCo the
# model the description names; on Gazebo and Isaac the scenario half the backend host
# completes), includes the backend host, spawns the robot's controllers by role,
# starts the launch roles the controller activates, includes the controller entry's
# launch, and starts the scenario node for a scenario with objects.
# Each block: role, package, artifact.
...@styles
direction: down

run: "" {
  grid-rows: 3
  class: block
  r: Run Launch { class: role }
  p: fm_sim_bringup { class: pkg }
  a: "run.launch.py backend robot scenario controller" { class: art }
}

index: "" {
  grid-rows: 3
  class: block
  r: Catalog { class: role }
  p: ament index { class: pkg }
  a: "fm_sim.backends · robots · scenarios · controllers" { class: art }
}

robot: "" {
  grid-rows: 3
  class: block
  r: Robot Description { class: role }
  p: fm_control (fm-robot) { class: pkg }
  a: "<robot>.sim.urdf.xacro sim_backend:=…" { class: art }
}

backend: "" {
  grid-rows: 3
  class: zoom
  r: Backend Host { class: role }
  p: fm_sim_backends { class: pkg }
  a: "robot_state_publisher · controller_manager" { class: art }
}

spawn: "" {
  grid-rows: 2
  class: block
  r: Controller Spawners { class: role }
  a: "broadcasters + activated roles active · rest inactive" { class: art }
}

ctl: "" {
  grid-rows: 2
  class: block
  r: Controller Under Test { class: role }
  a: "entry launch · use_sim · robot_profile" { class: art }
}

world: "" {
  grid-rows: 3
  class: block
  r: World Generator { class: role }
  p: fm_sim_scenarios { class: pkg }
  a: "scenario + seed → mujoco world · gazebo sdf · isaac stage" { class: art }
}

roles: "" {
  grid-rows: 2
  class: block
  r: Launch Roles { class: role }
  a: "servo · after the active spawner" { class: art }
}

scenario: "" {
  grid-rows: 3
  class: block
  r: Scenario Node { class: role }
  p: fm_sim_scenarios { class: pkg }
  a: "/sim/objects · markers · reset · outcome" { class: art }
}

run -> index: resolve + validate
index -> world
world -> robot: mujoco model
world -> backend: gazebo · isaac world
index -> robot
robot -> backend: robot_description
index -> spawn
spawn -> backend
spawn -> roles
index -> ctl
index -> scenario
