# vcs import < fm-sim.repos   (run from the workspace root)
#
# Standalone build deps: MJCF model sources (SO-ARM, OpenArm, Unitree), the Axol
# description fm-robot vendors, the Isaac backend's topic_based_ros2_control plugin
# (source-built on Jazzy), plus the shared fm-docker compose overlays (imported into
# docker/ so run.sh's container path can `docker compose -f docker/compose.yaml ...`).
repositories:
  docker:
    type: git
    url: https://github.com/first-motive/fm-docker.git
    version: ba304cc2cbf85fbb1da98168e718147198dfd279  # tag v0.1.0
  external/so_arm:
    type: git
    url: https://github.com/TheRobotStudio/SO-ARM100.git
    version: fda892cba81032c46c40976a48c9ceadbf40a9ca
  external/openarm_mujoco:
    type: git
    url: https://github.com/enactic/openarm_mujoco.git
    version: 5c6e1b4c71cbe27c6a4b58c7f198f080449e1b9c
  external/unitree_mujoco:
    type: git
    url: https://github.com/unitreerobotics/unitree_mujoco.git
    version: ae6a8403e272733e9996ef59990880330496177f
  # The Isaac backend's hardware plugin. It has no Jazzy apt release, so it is
  # built from source: CI lists it in build-externals, and the Dockerfile reads
  # this pin.
  external/topic_based_ros2_control:
    type: git
    url: https://github.com/PickNikRobotics/topic_based_ros2_control.git
    version: aa9f9ef9525a60f8becea322537dd1d6d1bf9123
  # fm-robot owns the robot descriptions run.launch.py expands (fm_control's
  # <robot>.sim.urdf.xacro). It publishes only a Humble image, so it is built from
  # source here, with the two externals its own manifest imports for that build.
  external/fm-robot:
    type: git
    url: https://github.com/first-motive/fm-robot.git
    version: 4dd3b0ae249b87ccc5ad149be7721887a5bd6218
  external/openarm_description:
    type: git
    url: https://github.com/enactic/openarm_description.git
    version: 846a82d8baf64efdbb7f55c7f64b9b004939061b
  # Axol's flat URDF and meshes, which fm-robot's fm_description vendors into its
  # share for axol.sim.urdf.xacro. File-only, so it stays COLCON_IGNORE'd. Same
  # pin as fm-robot.repos.
  external/axol:
    type: git
    url: https://github.com/almond-bot/axol.git
    version: ca5de52e5938c6bb174782dd5d504f8d6ec07662
  external/unitree_ros2:
    type: git
    url: https://github.com/unitreerobotics/unitree_ros2.git
    version: 5204e6e098ee53f4bd929bd77eb1d387cd0fa842
