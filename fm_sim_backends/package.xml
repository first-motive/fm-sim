<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>fm_sim_backends</name>
  <version>0.0.0</version>
  <description>Simulation backend hosts: per-engine launch files (mujoco, gazebo, isaac) that host the controller_manager inside the sim</description>
  <maintainer email="nish@ubundi.co.za">First Motive</maintainer>
  <license>Apache-2.0</license>

  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <!-- Every backend publishes /robot_description, which the Jazzy
       controller_manager reads from the topic. -->
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>controller_manager</exec_depend>

  <!-- Engine hosts and the hardware plugins each backend's description loads. -->
  <exec_depend>mujoco_ros2_control</exec_depend>
  <!-- config/mujoco_plugins.yaml: the free-joint state publisher. -->
  <exec_depend>mujoco_ros2_control_plugins</exec_depend>
  <exec_depend>ros_gz_sim</exec_depend>
  <exec_depend>ros_gz_bridge</exec_depend>
  <exec_depend>gz_ros2_control</exec_depend>
  <!-- No Jazzy apt release; built from source via fm-sim.repos. -->
  <exec_depend>topic_based_ros2_control</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>
  <test_depend>domain_coordinator</test_depend>
  <!-- test_description_topic.py launches the mujoco and isaac backends live. -->
  <test_depend>launch_testing</test_depend>
  <test_depend>rclpy</test_depend>
  <test_depend>std_msgs</test_depend>
  <test_depend>xvfb</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
