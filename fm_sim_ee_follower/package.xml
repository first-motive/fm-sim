<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>fm_sim_ee_follower</name>
  <version>0.0.0</version>
  <description>EE follower: damped-least-squares IK that turns a commanded tool pose into forward position commands for one arm</description>
  <maintainer email="nish@ubundi.co.za">First Motive</maintainer>
  <license>Apache-2.0</license>

  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>rcl_interfaces</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <!-- Chain FK and Jacobian (PyKDL); the URDF parse (urdf_parser_py). -->
  <exec_depend>python_orocos_kdl_vendor</exec_depend>
  <exec_depend>urdfdom_py</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>
  <!-- test_follower_node.py stamps messages and drives /clock. -->
  <test_depend>builtin_interfaces</test_depend>
  <test_depend>rosgraph_msgs</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
