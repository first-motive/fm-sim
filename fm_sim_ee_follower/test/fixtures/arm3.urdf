<?xml version="1.0"?>
<!-- Three-joint test arm: a fixed mount, revolute z, revolute y with limits, continuous
     y, then a fixed tool frame. A second branch (other_link) is off the chain. -->
<robot name="arm3">
  <link name="base_link"/>
  <link name="link0"/>
  <link name="link1"/>
  <link name="link2"/>
  <link name="link3"/>
  <link name="tool"/>
  <link name="other_link"/>
  <joint name="mount" type="fixed">
    <parent link="base_link"/>
    <child link="link0"/>
    <origin xyz="0 0 0.1" rpy="0 0 0"/>
  </joint>
  <joint name="other_joint" type="revolute">
    <parent link="base_link"/>
    <child link="other_link"/>
    <axis xyz="0 0 1"/>
    <limit lower="-1" upper="1" effort="1" velocity="1"/>
  </joint>
  <joint name="arm_joint1" type="revolute">
    <parent link="link0"/>
    <child link="link1"/>
    <origin xyz="0 0 0.2" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-2.0" upper="2.0" effort="10" velocity="3.0"/>
  </joint>
  <joint name="arm_joint2" type="revolute">
    <parent link="link1"/>
    <child link="link2"/>
    <origin xyz="0 0 0.3" rpy="0.1 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-0.5" upper="1.5" effort="10" velocity="3.0"/>
  </joint>
  <joint name="arm_joint3" type="continuous">
    <parent link="link2"/>
    <child link="link3"/>
    <origin xyz="0.3 0 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit effort="10" velocity="2.0"/>
  </joint>
  <joint name="tool_joint" type="fixed">
    <parent link="link3"/>
    <child link="tool"/>
    <origin xyz="0.1 0 0" rpy="0 0.2 0"/>
  </joint>
</robot>
