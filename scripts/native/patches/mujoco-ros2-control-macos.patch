+#ifdef __APPLE__
+bool CameraPlugin::init_egl_context()
+{
+  // The pixel format MuJoCo's own Python bindings use for their CGL backend: the legacy
+  // (compatibility) profile MuJoCo's renderer needs, rendering into its offscreen FBO.
+  const CGLPixelFormatAttribute attribs[] = { kCGLPFAOpenGLProfile,
+                                              static_cast<CGLPixelFormatAttribute>(kCGLOGLPVersion_Legacy),
+                                              kCGLPFAColorSize,
+                                              static_cast<CGLPixelFormatAttribute>(24),
+                                              kCGLPFAAlphaSize,
+                                              static_cast<CGLPixelFormatAttribute>(8),
+                                              kCGLPFADepthSize,
+                                              static_cast<CGLPixelFormatAttribute>(24),
+                                              kCGLPFAStencilSize,
+                                              static_cast<CGLPixelFormatAttribute>(8),
+                                              kCGLPFAAccelerated,
+                                              static_cast<CGLPixelFormatAttribute>(0) };
+  CGLPixelFormatObj pixel_format = nullptr;
+  GLint num_formats = 0;
+  CGLError err = CGLChoosePixelFormat(attribs, &pixel_format, &num_formats);
+  if (err != kCGLNoError || pixel_format == nullptr)
+  {
+    RCLCPP_ERROR(node_->get_logger(), "CGL: Failed to choose pixel format (%s)", CGLErrorString(err));
+    return false;
+  }
+  err = CGLCreateContext(pixel_format, nullptr, &cgl_context_);
+  CGLReleasePixelFormat(pixel_format);
+  if (err != kCGLNoError)
+  {
+    RCLCPP_ERROR(node_->get_logger(), "CGL: Failed to create context (%s)", CGLErrorString(err));
+    cgl_context_ = nullptr;
+    return false;
+  }
+  err = CGLSetCurrentContext(cgl_context_);
+  if (err != kCGLNoError)
+  {
+    RCLCPP_ERROR(node_->get_logger(), "CGL: Failed to make context current (%s)", CGLErrorString(err));
+    cleanup_egl_context();
+    return false;
+  }
+  RCLCPP_INFO(node_->get_logger(), "CGL: Successfully initialized offscreen OpenGL context");
+  return true;
+}
+
+void CameraPlugin::cleanup_egl_context()
+{
+  if (cgl_context_ != nullptr)
+  {
+    CGLSetCurrentContext(nullptr);
+    CGLReleaseContext(cgl_context_);
+    cgl_context_ = nullptr;
+  }
+}
+#else
 bool CameraPlugin::init_egl_context()
 {
   // Get EGL display
@@ -433,6 +494,8 @@ void CameraPlugin::cleanup_egl_context()
   }
 }
 
+#endif
